# SkillBridge AI Backend Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=skillbridge_db
PGUSER=postgres
PGPASSWORD=
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true

# Security & CORS Configuration (comma-separated allowed origins in production)
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Authentication & Session Security
# In production, generate distinct >= 32-char random hex secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30m
CSRF_SECRET=
COOKIE_SECRET=

# Disable passwordless demo persona switching in production unless explicitly evaluating MVP
ALLOW_DEMO_SESSION=true

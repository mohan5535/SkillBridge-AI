@startuml
left to right direction
skinparam packageStyle rectangle

actor "Candidate / Job Seeker" as Candidate
actor "Career Counselor / Admin" as Admin
actor "Assessment Engine" as Assessor

rectangle "SkillBridge AI — Career Gap Tracker" {
    usecase "UC-01: Maintain Candidate Profile\n& Qualifications" as UC1
    usecase "UC-02: Record Work Experience\n& Career Breaks" as UC2
    usecase "UC-03: Select & Target Career Role" as UC3
    usecase "UC-04: Execute Automated Gap Analysis" as UC4
    usecase "UC-05: Generate Learning Roadmap" as UC5
    usecase "UC-06: Complete Skill Assessment" as UC6
    usecase "UC-07: Define Career Roles & Standards" as UC7
    usecase "UC-08: View Executive Readiness Dashboard" as UC8
}

Candidate --> UC1
Candidate --> UC2
Candidate --> UC3
Candidate --> UC4
Candidate --> UC5
Candidate --> UC6

Admin --> UC7
Admin --> UC8
Admin --> UC4

Assessor --> UC6

UC4 ..> UC3 : <<include>>
UC5 ..> UC4 : <<extend>>
@enduml
